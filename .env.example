# Copy to .env.production (for builds) or .env.local (for `npm run dev`) and fill in.
# Every variable here is PUBLIC (NEXT_PUBLIC_*): it ends up in the shipped HTML/JS.
# Never put passwords, API secrets or private keys in this project — it has no server to keep them on.

# Your live domain, with https:// and WITHOUT "www." and WITHOUT a trailing slash.
# Used for the canonical URL, Open Graph/Twitter tags, sitemap.xml and robots.txt.
# Optional: production builds default to https://flowhq.in (Vercel uses its production URL). Not needed for `npm run dev`.
NEXT_PUBLIC_SITE_URL=https://flowhq.in
