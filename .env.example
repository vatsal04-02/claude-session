# Copy to .env.production (for builds) or .env.local (for `npm run dev`) and fill in.
# Every variable here is PUBLIC (NEXT_PUBLIC_*): it ends up in the shipped HTML/JS.
# Never put passwords, API secrets or private keys in this project — it has no server to keep them on.

# Your canonical live domain, with https://, WITH "www." and WITHOUT a trailing slash.
# Used for the canonical URL, Open Graph/Twitter tags, sitemap.xml and robots.txt.
# Set it in Vercel for the Production environment only (previews are then automatically noindex).
# If missing (or set to a *.vercel.app URL), production builds use https://www.flowhq.co.in — never a Vercel hostname.
# (https://flowhq.co.in is treated as https://www.flowhq.co.in: the bare domain 308-redirects to www.)
# Not needed for `npm run dev`.
NEXT_PUBLIC_SITE_URL=https://www.flowhq.co.in
