# FlowHQ — Hostinger (Apache/LiteSpeed) config for the static export.
# This file is copied into ./out by `npm run build`; upload it together with everything else.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) One canonical host, always HTTPS: www.yourdomain.com -> https://yourdomain.com (one redirect).
  #    Matches NEXT_PUBLIC_SITE_URL without "www.". Works for any domain — nothing to edit.
  #    (Prefer www? Swap rule 1 for:  RewriteCond %{HTTP_HOST} !^www\. [NC]
  #                                   RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  #     and set NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 2) Always HTTPS. (Turn on SSL in hPanel BEFORE uploading, or the site will redirect to a broken https://.)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3) Clean URLs: /some-page -> some-page.html when that file exists (future pages; refreshes never 404).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Tell browsers to use HTTPS only (6 months). Only sent once SSL is active.
  Header always set Strict-Transport-Security "max-age=15552000" "expr=%{HTTPS} == 'on'"

  # Hashed build files never change -> cache for a year. HTML always revalidates so new deploys show up at once.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|mp4|webm|vtt)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>
